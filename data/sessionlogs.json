ormal; font-weight: 900; font-display: swap; src: url(\"data:font/woff2;base64,\") format(\"woff2\"); unicode-range: U+5927, U+6210, U+529F, U+6975, U+9650, U+96E3, U+5931, U+6557; }@keyframes dcard-in { \n  0% { opacity: 0; transform: translateY(6px) scale(0.98); }\n  100% { opacity: 1; transform: none; }\n}@keyframes dcard-sweep { \n  0% { transform: translate(-130%); opacity: 0; }\n  25% { opacity: 0.8; }\n  75% { opacity: 0.5; }\n  100% { transform: translate(320%); opacity: 0; }\n}@keyframes med-pulse { \n  0%, 100% { opacity: 0.6; }\n  50% { opacity: 0.95; }\n}.dcard-tkt[data-level=\"sum\"] { --lv: var(--accent); }.dcard-tkt { --lv: var(--accent); --ink: #20242e; --sub: #6b7280; position: relative; margin-top: 4px; display: flex; align-items: stretch; border: 1px solid rgb(221, 225, 234); border-radius: 8px; background: linear-gradient(135deg, rgb(255, 255, 255), rgb(238, 241, 246) 78%); box-shadow: rgba(18, 24, 40, 0.18) 0px 6px 18px, rgba(255, 255, 255, 0.7) 0px 0px 0px 1px inset; overflow: hidden; color: var(--ink); animation: 0.32s cubic-bezier(0.2, 0.9, 0.25, 1) 0s 1 normal both running dcard-in; }.tkt-body { flex: 1 1 0%; min-width: 0px; padding: 11px 14px 12px; }.tkt-top { display: flex; align-items: center; gap: 6px; }.tkt-star { color: var(--lv); font-size: 10px; font-style: normal; }.tkt-word { margin-top: 3px; font-family: var(--font-display, Georgia, \"Times New Roman\", serif); font-size: 23px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; line-height: 1; color: var(--lv); }.tkt-script { font-family: \"Pinyon Script\", \"Snell Roundhand\", \"Segoe Script\", \"Brush Script MT\", cursive; font-size: 20px; font-style: normal; line-height: 1.05; color: color-mix(in srgb,var(--lv) 70%,var(--ink)); }.tkt-meta { margin-top: 5px; font-size: 11px; color: var(--sub); }.tkt-meta b { color: var(--ink); font-weight: 700; }@media (prefers-reduced-motion: reduce){.dcard-tkt { animation: auto ease 0s 1 normal none running none; }}[data-theme=\"light\"] .dcard-tkt { --ink: #20242e; --sub: #6b7280; background: linear-gradient(135deg, rgb(255, 255, 255), rgb(244, 246, 250) 78%); border-color: rgb(215, 220, 230); box-shadow: rgba(40, 55, 90, 0.12) 0px 6px 16px, rgba(255, 255, 255, 0.7) 0px 0px 0px 1px inset; }.mk-bg { padding: 0.12em 0.2em; border-radius: 3px; box-decoration-break: clone; -webkit-box-decoration-break: clone; }.mk-box { border: 1px solid var(--line2); border-radius: 2px; padding: 8px 10px; margin: 3px 0px; }.mk-bubble { display: inline-block; max-width: 100%; padding: 8px 15px; border-radius: 16px; line-height: 1.5; background: color-mix(in srgb,var(--tx) 12%,transparent); border: 1px solid color-mix(in srgb,var(--tx) 8%,transparent); box-shadow: rgba(0, 0, 0, 0.12) 0px 1px 4px; word-break: break-word; }.msg-choice { position: relative; margin: 0px 6px; }.choice-card { margin: 4px 0px; padding: 10px 14px; border-radius: 10px; background: color-mix(in srgb,var(--accent) 8%,transparent); border: 1px solid color-mix(in srgb,var(--accent) 40%,transparent); }.choice-prompt { display: flex; align-items: center; justify-content: center; text-align: center; gap: 5px; font-weight: 700; font-size: 13px; color: var(--tx); margin-bottom: 8px; }.choice-opts { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; }.choice-opt { padding: 6px 12px; border-radius: 8px; border: 1px solid var(--line2); background: var(--bg3); color: var(--tx); font-size: 12.5px; font-weight: 600; cursor: pointer; }.choice-opt:disabled { opacity: 0.55; cursor: default; }.msg-script { position: relative; margin: 0px 6px; padding: 5px 12px; border-radius: 2px; background: color-mix(in srgb,var(--tx) 6%,transparent); text-align: center; font-family: \"Pretendard Variable\", Pretendard, \"Malgun Gothic\", sans-serif; letter-spacing: -0.3px; line-height: 1.5; font-size: calc(1em * var(--chat-font-scale, 1)); word-break: break-word; white-space: pre-wrap; }.msg-script + .msg-script { margin-top: -9px; }.msg-script:has(.mk-box), .msg-script:has(.mk-img), .msg-script:has(.mk-bubble) { background: none; padding: 0px; }.msg-script .mk-box { margin: 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 2px 12px; }@keyframes fxcard-pop { \n  0% { opacity: 0; transform: translate(7%) scale(0.86); }\n  11% { opacity: 1; transform: translate(0px) scale(1.03); }\n  20% { transform: translate(0px) scale(1); }\n  80% { opacity: 1; transform: translate(0px) scale(1); }\n  100% { opacity: 0; transform: translate(-4%) scale(1.05); }\n}@keyframes fxcard-veil { \n  0% { opacity: 0; }\n  11% { opacity: 1; }\n  80% { opacity: 1; }\n  100% { opacity: 0; }\n}@keyframes fxcard-pop-in { \n  0% { opacity: 0; transform: translate(7%) scale(0.86); }\n  70% { opacity: 1; transform: translate(0px) scale(1.03); }\n  100% { opacity: 1; transform: translate(0px) scale(1); }\n}@keyframes fxcard-veil-in { \n  0% { opacity: 0; }\n  100% { opacity: 1; }\n}</style>\n<style>\n/* 페이지 여백 0 — @page 여백 영역은 항상 종이색(흰색)이라 칠할 수 없으므로, 0으로 해\n   루트(html) 배경이 페이지 전체를 가득 채우게(흰 여백 밴드 제거 · 페이지 사이 배경 연속). */\n@page { margin: 0; }\n/* 모든 요소의 색·배경을 인쇄에 그대로 — 브라우저가 배경을 빼지 않게(다크/라이트 테마 배경이 PDF 에 반영). */\n*, *::before, *::after { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; animation: none !important; transition: none !important; }\n/* 앱 전역 CSS 의 height:100% · overflow:hidden · zoom 을 해제(안 하면 1페이지에서 잘림). */\nhtml, body { margin: 0 !important; padding: 0 !important; height: auto !important; min-height: 0 !important; overflow: visible !important; zoom: 1 !important; }\n/* 페이지 배경(여백 제외 캔버스)=테마 배경색 — html 에도 칠해 본문이 짧아도 흰 여백이 안 보이게(다크 테마면 어둡게). */\nhtml { background: var(--bg2, var(--bg, #0e1220)); }\nbody {\n  background: var(--bg2, var(--bg, #0e1220));\n  color: var(--tx, #e8eaf0);\n  font-family: var(--font-ui, 'Malgun Gothic','Apple SD Gothic Neo','Noto Sans KR',sans-serif);\n  background-attachment: initial;\n}\n/* 채팅 패널 — 화면 폭 그대로, 가운데 정렬, 스크롤/테두리 해제 */\n.pdf-chat { width: var(--chat-w, 346px); max-width: 100%; margin: 14px auto 0; border: 0 !important; background: transparent !important; }\n.pdf-chat .log {\n  display: flex; flex-direction: column;\n  height: auto !important; max-height: none !important; min-height: 0 !important;\n  overflow: visible !important; flex: none !important;\n}\n/* 카드(주사위·행운·선택지·광기)만 페이지 경계에서 자르지 않음. 일반 채팅/지문은 연속 흐름시켜\n   페이지 하단의 빈 세로 여백을 최소화(채팅 로그가 끊김 없이 이어져 보이게). */\n.dcard-ed, .dcard-med, .dcard-tkt, .dcard-cjk, .dice, .choice-card, .luck-result, .luck-card, .madness-card {\n  page-break-inside: avoid; break-inside: avoid;\n}\n/* 인쇄에 불필요한 상호작용 UI 숨김(복제본에 남아도 안전망). .log-more=「이전 대화 더 보기/최근 N개만 보기」 알약 버튼. */\n.msg-actions, .chat-resizer, .typing-ind, .msg-edit, .log-more { display: none !important; }\n/* 머리말·꼬리말(테마색 사용) — 제목(=방 이름) 가운데 + 강조색, 날짜도 가운데. */\n.pdf-head { width: var(--chat-w, 346px); max-width: 100%; margin: 0 auto; padding: 10px 8px 6px; text-align: center; }\n.pdf-head h1 { font-size: 20px; margin: 0 0 3px; color: var(--accent, var(--tx, #e8eaf0)); }\n.pdf-head .sub { font-size: 11px; color: var(--tx3, #8a90a0); }\n.pdf-foot { width: var(--chat-w, 346px); max-width: 100%; margin: 14px auto 0; padding: 8px 8px 12px; border-top: 1px solid var(--line, rgba(127,127,127,0.3)); color: var(--tx3, #888); font-size: 10px; text-align: center; }\n</style>\n<style>.cav-0{background-image:url(\"asset:95e2f2215eb73e287eea1c8ce2c85235b9f1565d546ad35cb12e32bc5a7cb61d\")}</style>\n</head>\n<body>\n<div class=\"pdf-head\">\n  <h1>TEST</h1>\n  <div class=\"sub\">2026-08-02 00:32</div>\n</div>\n<div class=\"chat pdf-chat\"><div class=\"log\"><div class=\"msg\"><div class=\"pic cav-0\" title=\"크게 보기\" style=\"cursor: zoom-in;\"></div><div class=\"body\"><div class=\"who\"><span>온</span><span>21:07</span></div><div class=\"dcard dcard-tkt\" data-level=\"sum\"><div class=\"tkt-body\"><div class=\"tkt-top\"><i class=\"tkt-star\">✦</i></div><div class=\"tkt-word\">1</div><div class=\"tkt-scrip